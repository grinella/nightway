# Routing pedonale (Valhalla). Default: server pubblico FOSSGIS, fair use, nessuno SLA.
VALHALLA_URL=https://valhalla1.openstreetmap.de

# Overpass: uno o più endpoint separati da virgola, provati in ordine.
OVERPASS_URL=https://overpass.openstreetmap.fr/api/interpreter,https://overpass-api.de/api/interpreter

# Assistente (Claude). Senza chiave l'assistente risponde «non configurato».
ANTHROPIC_API_KEY=

# Voce dell'assistente (ElevenLabs). Senza chiave il pulsante «Ascolta» segnala che la voce non è configurata.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Vision: predisposta e disattivata. Nessun provider reale è collegato.
VISION_ENABLED=false
MAPILLARY_TOKEN=
